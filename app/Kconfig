rsource "status/Kconfig"

config IDU_SAMPLE_PERIOD_MS
    int "Acquisition period in milliseconds"
    default 500
    range 100 1000

config IDU_ADC_AVERAGE_COUNT
    int "Samples averaged per product analog input"
    depends on ADC
    default 10
    range 1 64

config IDU_IAPV3
    bool "MV-IO IAPv3 AES/SGZ receiver"
    depends on BOOTLOADER_MCUBOOT && !MCUMGR_GRP_IMG

config IDU_TRANSMIT
    bool "Product Modbus slave forwarding port"
    depends on TRANSMIT && UART_INTERRUPT_DRIVEN && DT_HAS_IDU_FORWARD_PORT_ENABLED
    default y if BOARD_IDU_PRE
    help
      Application-owned UART thread with timestamped input and RS485 direction.
      Station address is loaded once from the saved process parameter.

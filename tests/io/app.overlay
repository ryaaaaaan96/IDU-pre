#include <zephyr/dt-bindings/gpio/gpio.h>
/ {
    led_gpio: led-gpio {
        compatible = "zephyr,gpio-emul";
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <1>;
    };
    test-leds {
        compatible = "gpio-leds";
        test_led: output { gpios = <&led_gpio 0 GPIO_ACTIVE_LOW>; };
    };
};

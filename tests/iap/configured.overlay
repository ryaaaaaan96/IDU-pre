/ {
    chosen {
        iap,staging = &iap_staging;
        iap,journal = &iap_journal;
        zephyr,sram = &test_ram;
    };
    test_ram: memory@30000000 {
        compatible = "mmio-sram";
        reg = <0x30000000 0x20000>;
    };
};
&iap_staging { reg = <0x201000 0x20000>; };
&iap_journal { reg = <0x180000 0x2000>; };

&flashcontroller0 { reg = <0 0x400000>; };
&flash0 {
    reg = <0 0x400000>;
    /delete-node/ partitions;
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;
        boot_partition: partition@0 { reg = <0 0x10000>; };
        slot0_partition: partition@10000 { reg = <0x10000 0x70000>; };
        slot1_partition: partition@300000 { reg = <0x300000 0x70000>; };
        scratch_partition: partition@370000 { reg = <0x370000 0x2000>; };
        iap_journal: partition@180000 { reg = <0x180000 0x4000>; };
        iap_staging: partition@201000 { reg = <0x201000 0xf0000>; };
    };
};

#include <zephyr/dt-bindings/gpio/gpio.h>
/ {
    aliases { led0 = &status_led; };
    leds { compatible = "gpio-leds";
        status_led: run { gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>; };
    };
    idu_io: zephyr,user {
        watchdog-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
        watchdog-feed-ms = <10>;
    };
};

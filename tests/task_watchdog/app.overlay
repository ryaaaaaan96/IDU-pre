#include <zephyr/dt-bindings/gpio/gpio.h>
/ {
    aliases { led0 = &status_led; };
    leds { compatible = "gpio-leds";
        status_led: run { gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>; };
    };
    idu_io: zephyr,user {
    };
};

/ {
    external_watchdog: external-watchdog {
        compatible = "app,gpio-watchdog";
        feed-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
        feed-interval-ms = <10>;
        status = "okay";
    };
};

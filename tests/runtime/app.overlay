#include <zephyr/dt-bindings/gpio/gpio.h>
/ {
    gpio_test: gpio-test {
        compatible = "zephyr,gpio-emul";
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <4>;
        status = "okay";
    };
    uart_test: uart-test {
        compatible = "zephyr,uart-emul";
        current-speed = <115200>;
        rx-fifo-size = <2048>;
        tx-fifo-size = <512>;
        status = "okay";
        modbus_test: modbus {
            compatible = "zephyr,modbus-serial";
            de-gpios = <&gpio_test 0 GPIO_ACTIVE_HIGH>;
            status = "okay";
        };
    };
};
/ { aliases { idu-forward = &modbus_test; idu-settings = &storage_partition; }; };
/ {
    aliases { led0 = &status_led; };
    status_leds: status-leds {
        compatible = "gpio-leds";
        status_led: run { gpios = <&gpio_test 2 GPIO_ACTIVE_LOW>; };
    };
    idu_io: zephyr,user {
    };
};

/ {
    external_watchdog: external-watchdog {
        compatible = "app,gpio-watchdog";
        feed-gpios = <&gpio_test 1 GPIO_ACTIVE_HIGH>;
        feed-interval-ms = <20>;
        status = "okay";
    };
};

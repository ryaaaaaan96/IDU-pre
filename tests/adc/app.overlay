#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
/ {
    idu_io: inputs {
        compatible = "idu,pre-io";
        di1-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
        di2-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
        di3-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
        di4-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
        di5-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
        di6-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
        di7-gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
        di8-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
        di9-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
        di10-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
        di11-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
        di12-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
        di13-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
        di14-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
        di15-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
        di16-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
        address1-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
        address2-gpios = <&gpio0 18 GPIO_ACTIVE_LOW>;
        address3-gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;
        address4-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
        io-channels = <&adc0 12>, <&adc0 1>, <&adc0 4>, <&adc0 13>, <&adc0 11>, <&adc0 0>, <&adc0 3>, <&adc0 2>;
        io-channel-names = "current-8", "current-3", "current-6", "current-1", "current-7", "current-2", "current-5", "current-4";
    };
};
&adc0 {
    nchannels = <16>;
    ref-vdd-mv = <3300>;
    #address-cells = <1>;
    #size-cells = <0>;
    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
    channel@3 {
        reg = <3>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
    channel@4 {
        reg = <4>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
    channel@b {
        reg = <11>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
    channel@c {
        reg = <12>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
    channel@d {
        reg = <13>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
};

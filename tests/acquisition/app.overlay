#include <zephyr/dt-bindings/gpio/gpio.h>
/ {
    aliases {
        led0 = &status_led;
        idu-settings = &storage_partition;
    };
    external_flash: test-flash {};
    status_leds: status-leds {
        status_led: run {};
    };
    idu_io: zephyr,user {
        watchdog-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
        watchdog-feed-ms = <10>;
    };
};

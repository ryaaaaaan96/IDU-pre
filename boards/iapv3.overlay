/* Same SGZ address as the deployed firmware; independent NVS result journal. */
/ {
    chosen {
        iap,staging = &iap_staging;
        iap,journal = &iap_journal;
    };
};
&upgrade_config { reg = <0x200000 0x1000>; };
&{/soc/spi@40003800/flash@0/partitions} {
    iap_journal: partition@18000 {
        label = "idu-iap-journal";
        reg = <0x18000 0x4000>;
    };
    iap_staging: partition@201000 {
        label = "idu-iap-sgz";
        reg = <0x201000 0xf0000>;
    };
};

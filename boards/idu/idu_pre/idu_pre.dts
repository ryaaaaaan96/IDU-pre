/dts-v1/;

#include <mem.h>
#include <arm/gd/gd32e505.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include "idu_pre-pinctrl.dtsi"

/ {
    model = "IDU-pre MV-IO GD32E505";
    compatible = "idu,pre";

    hxtal: hxtal-clock {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <20000000>; /* 有源振荡器接入 OSC_IN，必须启用旁路。 */
    };

    pll: pll {
        compatible = "gd,gd32e505-pll";
        #clock-cells = <0>;
        clocks = <&hxtal>;
        hxtal-bypass;
        prediv = <5>;
        mul = <45>;
        apb1-prescaler = <2>;
        apb2-prescaler = <1>;
    };

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,flash-controller = &fmc;
        zephyr,console = &usart0;
        zephyr,shell-uart = &usart0;
        zephyr,code-partition = &slot0_partition;
        iap,staging = &iap_staging;
        iap,journal = &iap_journal;
    };

    aliases {
        dp-params = &dp_params;
        led0 = &run_led;
        idu-forward = &modbus0;
        /* CO/TR 共用此 RS485 链路，用于单总线性能测试。 */
    };

    leds {
        compatible = "gpio-leds";
        run_led: run-led { gpios = <&gpioa 8 GPIO_ACTIVE_LOW>; };
    };

    idu_io: idu-io {
        compatible = "idu,pre-io";
        di-bit-order = "lsb-first";
        address-bit-order = "msb-first";
        address-offset = <1>;
        io-channels = <&adc0 13>, <&adc0 0>, <&adc0 1>, <&adc0 2>, <&adc0 3>, <&adc0 4>, <&adc0 11>, <&adc0 12>;
        io-channel-names = "current-1", "current-2", "current-3", "current-4", "current-5", "current-6", "current-7", "current-8";
        di1-gpios = <&gpioc 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di2-gpios = <&gpioc 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di3-gpios = <&gpioc 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di4-gpios = <&gpioc 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di5-gpios = <&gpiob 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di6-gpios = <&gpiob 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di7-gpios = <&gpiob 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di8-gpios = <&gpiob 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di9-gpios = <&gpioe 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di10-gpios = <&gpiob 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di11-gpios = <&gpiob 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di12-gpios = <&gpioe 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di13-gpios = <&gpioe 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di14-gpios = <&gpioe 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di15-gpios = <&gpioe 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        di16-gpios = <&gpioe 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        address1-gpios = <&gpiod 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        address2-gpios = <&gpiod 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        address3-gpios = <&gpiod 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        address4-gpios = <&gpiod 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    soc {
        spi1: spi@40003800 {
            compatible = "gd,gd32-spi";
            reg = <0x40003800 0x400>;
            interrupts = <36 0>;
            clocks = <&cctl GD32_CLOCK_SPI1>;
            resets = <&rctl GD32_RESET_SPI1>;
            #address-cells = <1>;
            #size-cells = <0>;
            pinctrl-0 = <&flash_spi_default>;
            pinctrl-names = "default";
            cs-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;
            status = "okay";
            external_flash: flash@0 {
                compatible = "jedec,spi-nor";
                reg = <0>;
                spi-max-frequency = <10000000>;
                spi-cpol;
                spi-cpha;
                size = <33554432>; /* W25Q32：32 Mbit，需核对实际装配型号。 */
                partitions {
                    compatible = "fixed-partitions";
                    #address-cells = <1>;
                    #size-cells = <1>;
                    dp_params: partition@10000 {
                        label = "dp-params";
                        reg = <0x10000 0x4000>;
                    };
                    /* IAPv3 结果日志；偏移与既有设备保持一致，不参与参数清空。 */
                    iap_journal: partition@18000 {
                        label = "idu-iap-journal";
                        reg = <0x18000 0x4000>;
                    };
                    /* SGZ 暂存上限与 CONFIG_IAP_MAX_CONTAINER_SIZE 成对维护。 */
                    iap_staging: partition@201000 {
                        label = "idu-iap-sgz";
                        reg = <0x201000 0x80000>;
                    };
                };
            };
        };
    };
};

&flash0 {
    reg = <0x08000000 DT_SIZE_K(512)>;
    write-block-size = <4>; /* E505 FMC 支持按字编程。 */
    erase-block-size = <8192>; /* 参见 GD32E50x 用户手册第 2.3.1 节。 */
};
&sram0 { reg = <0x20000000 DT_SIZE_K(128)>; };
&gpioa { status = "okay"; };
&gpiob { status = "okay"; };
&gpioc { status = "okay"; };
&gpiod { status = "okay"; };
&gpioe { status = "okay"; };
&usart0 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&debug_uart_default>;
    pinctrl-names = "default";
};
&usart2 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&rs485_uart_default>;
    pinctrl-names = "default";
    modbus0: modbus {
        compatible = "zephyr,modbus-serial";
        de-gpios = <&gpioa 15 GPIO_ACTIVE_HIGH>;
        status = "okay";
    };
};

&adc0 {
    status = "okay";
    clock-prescaler = <6>;
    vdda-millivolts = <3300>;
    pinctrl-0 = <&analog_default>;
    pinctrl-names = "default";
    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
    channel@3 {
        reg = <3>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
    channel@4 {
        reg = <4>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
    channel@b {
        reg = <11>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
    channel@c {
        reg = <12>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
    channel@d {
        reg = <13>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 72)>;
        zephyr,resolution = <12>;
    };
};

/* 产品镜像布局，由应用和 MCUboot 共用。 */
#include "../../../bootloader/partitions.dtsi"

/ {
    external_watchdog: external-watchdog {
        compatible = "app,gpio-watchdog";
        feed-gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
        feed-interval-ms = <10>;
        status = "okay";
    };
};

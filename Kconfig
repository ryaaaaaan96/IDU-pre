mainmenu "IDU-pre"

source "Kconfig.zephyr"
rsource "app/Kconfig"

config IDU_PRE
    bool
    default y
    select COLLECT if DATAPROCESS
    select TRANSMIT if DATAPROCESS
    select DP_PROCESS if DATAPROCESS
    select TR_MODBUS_ADAPTER if DATAPROCESS

config IDU_ADC_AVERAGE_COUNT
    int "Samples averaged per analog input"
    default 10
    range 1 64

rsource "app/iap/Kconfig"

menuconfig COLLECT
    bool "Equipment acquisition and bus scheduling"
    depends on DATAPROCESS && MODBUS
    default y if MODBUS_CLIENT

if COLLECT

config CO_EXCHANGE_TIMEOUT_MS
    int "Total budget per southbound message exchange (ms)"
    default 500
    range 10 10000
    help
      Includes bus and transport ownership, sending and the response wait.
      Each automatic retry receives a new budget. Backend callbacks must honor
      their supplied remaining timeout; contention before sending is EBUSY.

config HEAP_MEM_POOL_ADD_SIZE_COLLECT
    int "Shared heap budget for acquisition queues and message buffers (bytes)"
    default 12288
    range 1024 131072
    help
      Covers queued/active request copies and concurrent temporary ADUs,
      sample batches and RAW frames. Tune for bus count, queue depth and
      MODBUS_BUFFER_SIZE. Allocation failures return ENOMEM without sending.

config CO_MAX_BUSES
    int "Maximum acquisition buses"
    default 1
    range 1 8
    help
      Number of statically reserved bus states and request queues.
      Bus IDs must be in the range 0 to CO_MAX_BUSES - 1. Only registered buses
      may be run by application-owned workers. Stacks are supplied by the
      application; all configured state/queue slots reserve RAM.

config CO_QUEUE_DEPTH
    int "Maximum queued requests per acquisition bus"
    default 4
    range 1 16

config CO_STACK_SIZE
    int "Stack size per acquisition bus (bytes)"
    default 4096
    range 1024 65536
    help
      Stack size used by applications creating a bus worker, including
      acquisition backend callbacks. The application declares stacks only for
      its configured execution contexts; collect does not allocate stacks.
      Size this for the complete backend call chain. In particular, large
      MODBUS_BUFFER_SIZE values increase stack-local ADU and RAW frame buffers;
      the default does not guarantee enough space for every transport setup.

config CO_VPORT
    bool "Complete-message ports through vport"
    select VPORT

rsource "protocols/modbus/Kconfig"

config CO_MODEL_SIMULATOR
    bool "Reference model default-value simulator"
    depends on DP_REFERENCE_TABLES

endif

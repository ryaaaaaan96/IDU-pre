config TR_CONN_TIMEOUT_MS
    int "Accepted Modbus request inactivity timeout (ms)"
    default 5000
    range 10 3600000

config TR_MODBUS_ADAPTER
    bool "Whole-PDU Modbus routing and isolated forwarding workers"
    default y if DP_PARAMS
    help
      Enable the reviewed build-local Zephyr Modbus adapter for complete-request
      routing and isolated workers. This is also available without NVS storage.

config TR_STACK_SIZE
    int "Stack size per isolated forwarding port (bytes)"
    default 4096
    range 1024 65536
    depends on TR_MODBUS_ADAPTER
    help
      Stack size for each isolated forwarding worker, including protocol and
      write callbacks. Total reserved stack space is TR_PORTS times this size,
      plus any architecture alignment or guard requirements.

config TR_PORTS
    int "Independent forwarding workqueues"
    default 1
    range 1 4
    depends on TR_MODBUS_ADAPTER
    help
      Number of statically reserved isolated forwarding workers and stacks.
      Unused slots still reserve RAM. This is separate from the number of
      interfaces bound to the Modbus virtual-port transport.

config TR_CONFIG_STACK_SIZE
    int "Shared forwarding reconfiguration stack size (bytes)"
    default 2048
    range 1024 65536
    depends on TR_MODBUS_ADAPTER
    help
      One shared control worker handles port reconfiguration and recovery.
      Its stack is reserved once, independently of TR_PORTS.

config TR_SERVER_SERVICE
    bool "Configured forwarding server lifecycle"
    depends on TR_MODBUS_ADAPTER

config TR_REGISTER_SERVICE
    bool "Configured address segments and protocol extension"
    depends on TR_MODBUS_ADAPTER


config TR_MODBUS_RAW_PORT
    bool "Modbus RAW complete-message port adapter"
    depends on TR_MODBUS_ADAPTER && MODBUS_RAW_ADU
    depends on !MODBUS_SERIAL_ASYNC_API
    select TR_VPORT

config TR_MODBUS_TX_TIMEOUT_MS
    int "Complete-message send timeout (ms)"
    depends on TR_MODBUS_RAW_PORT
    default 3000
    range 10 10000

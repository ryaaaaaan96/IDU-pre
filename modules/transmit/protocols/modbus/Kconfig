config TR_CONN_TIMEOUT_MS
    int "Accepted Modbus request inactivity timeout (ms)"
    default 5000
    range 10 3600000

config TR_MODBUS_ADAPTER
    bool "Whole-PDU Modbus routing and isolated forwarding workers"
    default y if DP_PARAMS
    help
      Enable the reviewed build-local Zephyr Modbus adapter for complete-request
      routing and isolated workers. This is also available without NVS storage.

config TR_STACK_SIZE
    int "Stack size per isolated forwarding port (bytes)"
    default 4096
    range 1024 65536
    depends on TR_MODBUS_ADAPTER
    help
      Stack size for each isolated forwarding worker, including protocol and
      write callbacks. The application supplies queues/stacks for its actual
      contexts; transmit does not create workers or allocate their stacks.

config TR_PORTS
    int "Maximum forwarding entries / isolated workqueues"
    default 1
    range 1 4
    help
      Maximum immutable forwarding mapping bindings. When TR_MODBUS_ADAPTER
      is enabled, also reserves this many isolated forwarding states.
      Stacks are supplied by the application. This is separate from the number of
      interfaces bound to the Modbus virtual-port transport.

config TR_CONFIG_STACK_SIZE
    int "Shared forwarding reconfiguration stack size (bytes)"
    default 2048
    range 1024 65536
    depends on TR_MODBUS_ADAPTER
    help
      Suggested stack size for the application-supplied control worker handling
      port reconfiguration and recovery. Transmit does not allocate this stack.

config TR_SERVER_SERVICE
    bool "Configured forwarding server lifecycle"
    depends on TR_MODBUS_ADAPTER

config TR_REGISTER_SERVICE
    bool "Configured protocol segments and standard address routes"
    depends on TR_MODBUS_ADAPTER


config TR_MODBUS_RAW_PORT
    bool "Modbus RAW complete-message port adapter"
    depends on TR_MODBUS_ADAPTER && MODBUS_RAW_ADU
    depends on !MODBUS_SERIAL_ASYNC_API
    select TR_VPORT

config TR_MODBUS_TX_TIMEOUT_MS
    int "Complete-message send timeout (ms)"
    depends on TR_MODBUS_RAW_PORT
    default 3000
    range 10 10000

config TR_FORWARD_CONFIG
    bool "Independent forwarding device declarations"
    depends on DP_TABLE_REGISTRY && TR_REGISTER_SERVICE && TR_SERVER_SERVICE
    help
      Resolve each forwarding entry's own const mapping and protocol segments.
      Data identities and parameter records remain owned by DP.

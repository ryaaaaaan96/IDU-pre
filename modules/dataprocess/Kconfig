menuconfig DATAPROCESS
    bool "Point tables and synchronous RAM values"
    select KERNEL_MEM_POOL
    select SYS_HASH_MAP
    select SYS_HASH_MAP_OA_LP
    select SYS_HASH_FUNC32

if DATAPROCESS

config HEAP_MEM_POOL_ADD_SIZE_DATAPROCESS
    int "System heap budget for registered devices and point data (bytes)"
    default 2048
    range 256 65536
    help
      Each device registration allocates one private node with its point data.
      Include the node, point_count times sizeof(dp_point_data_t), and heap overhead.
      Registration uses a temporary hashmap for duplicate keys. Include its
      bucket allocation and resize peak in addition to previously registered data.

endif

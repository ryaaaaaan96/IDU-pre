menuconfig DATAPROCESS
    bool "Data management and processing"
    select KERNEL_MEM_POOL
    select ZBUS
    select ZBUS_MSG_SUBSCRIBER
    select ZBUS_MSG_SUBSCRIBER_NET_BUF_POOL_ISOLATION

if DATAPROCESS

config DP_REFERENCE_OVERRIDES
    int "Maximum runtime default/range overrides (base tables stay const)"
    default 4
    range 1 32

config DP_REFERENCE_EVENTS
    int "Pending reference change/log notifications"
    default 4
    range 1 32
    depends on DP_PROCESS

config DP_REFERENCE_TABLES
    bool "Use reference DEV_TABLE_S point tables"
    depends on DP_PROCESS
    help
      Accept the reference device/process/Modbus table layouts through
      platform_callback.h. Unsupported protocols and flags fail initialization.
      Read const rows on demand through stack-local execution descriptors.
      Native Zephyr tables can use dp_register_config_provider without this
      option. No full-table RAM copies are allocated.

config DP_TABLE_REGISTRY
    bool "Discover const reference tables through iterable sections"
    depends on DP_REFERENCE_TABLES
    help
      Register each complete table once. Resolve device bindings by table ID,
      keeping rows in ROM and allocating only the caller-owned device view.

config DP_PROCESS
    bool "Business transactions, sample handlers and timers"
    default y
    help
      Run READ, INIT, WRITE, SAMPLE and TIMER handlers with bounded copied
      requests. Telemetry processing does not require flash or parameter storage.

config DP_REFERENCE_MAX_TIMERS
    int "Maximum reference business timer registrations"
    default 8
    range 1 32
    depends on DP_PROCESS

config DP_POINT_WORDS
    int "Maximum words in one point"
    default 16
    range 2 72

config DP_PROCESS_MAX_OUTPUTS
    int "Maximum points produced by one process transaction"
    default 24
    range 4 64

config DP_PROCESS_QUEUE_DEPTH
    int "Asynchronous process queue depth"
    default 4
    range 1 16

config DP_PROCESS_TIMERS
    int "Registered business timers"
    default 8
    range 1 32

config DP_PROCESS_STACK_SIZE
    int "Business processor thread stack size"
    default 6144
    depends on DP_PROCESS

config DP_MAX_DEVICES
    int "Maximum acquisition devices"
    default 16
    range 1 64

config DP_PARAMS
    bool "Transactional parameter writes and durable NVS snapshots"
    depends on FLASH && FLASH_PAGE_LAYOUT && FLASH_MAP
    select DP_PROCESS
    select NVS
    select NVS_DATA_CRC
    select REBOOT

config DP_PARAMS_SNAPSHOT_BYTES
    int "Maximum encoded parameter snapshot bytes"
    default 2048
    range 256 8192
    depends on DP_PARAMS

config DP_PARAMS_MAX_COUNT
    int "Maximum parameter points"
    default 16
    range 1 192
    depends on DP_PARAMS

config DP_POINTS_QUEUE_DEPTH
    int "Maximum pending acquisition batches"
    default 6
    range 1 16

config DP_POINTS_MAX_POINTS
    int "Maximum configured signals"
    default 64
    range 16 768

config DP_POINTS_VALUE_WORDS
    int "Maximum total words in configured point values"
    default 512
    range 64 16384
    help
      Upper bound for the sum of point widths, validated at startup.
      Initialization allocates only the actual total from the system heap.

config HEAP_MEM_POOL_ADD_SIZE_DATAPROCESS
    int "System heap budget for point values (bytes)"
    default 1024
    range 128 32768
    help
      Contribution to the shared Zephyr system heap, not a private DP arena.
      Include the configured point widths times two and allocator overhead.
      Other heap users need their own budget. A failed allocation leaves DP
      uninitialized.

config DP_POINTS_MAX_POLLS
    int "Maximum collection blocks"
    default 16
    range 1 512

config DP_POINTS_STACK_SIZE
    int "Point processor stack size"
    default 4096

endif

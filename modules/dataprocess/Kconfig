menuconfig DATAPROCESS
    bool "Data management and local parameter storage"
    select KERNEL_MEM_POOL
    select NVS
    select NVS_DATA_CRC
    depends on FLASH && FLASH_PAGE_LAYOUT && FLASH_MAP

if DATAPROCESS

config DP_PARAMS
    bool
    default y
    help
      Compatibility symbol for modules that select a parameter persistence
      policy. Parameters are always part of the minimal DP core.

config DP_POINT_WORDS
    int "Maximum words in one point"
    default 16
    range 2 72

config DP_POINTS_MAX_POINTS
    int "Maximum configured points"
    default 32
    range 16 768

config DP_POINTS_VALUE_WORDS
    int "Maximum total words in configured point values"
    default 512
    range 16 16384
    help
      Upper bound for the sum of point widths, validated at startup.
      Initialization allocates only the actual total from the system heap.

config DP_PARAMS_MAX_COUNT
    int "Maximum persistent parameters"
    default 8
    range 1 64

config DP_PARAMS_TRANSACTION_BYTES
    int "Maximum encoded parameter commit image"
    default 2048
    range 256 8192

config HEAP_MEM_POOL_ADD_SIZE_DATAPROCESS
    int "System heap budget for point values (bytes)"
    default 1024
    range 128 32768
    help
      Contribution to the shared Zephyr system heap, not a private DP arena.
      Include the configured point widths times two and allocator overhead.

config HEAP_MEM_POOL_ADD_SIZE_DP_PARAMS
    int "System heap budget for parameter cache and commit buffers (bytes)"
    default 4096
    range 1024 131072
    help
      Allocated once by the parameter store. Covers the per-parameter cache,
      staging/durable copies and the commit image. These buffers remain
      available during storage failure so cached reads can continue.

endif

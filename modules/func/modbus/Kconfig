# 完整 ADU 路由可接收旧协议长帧；标准功能码仍由官方服务端检查数量。
config MODBUS_BUFFER_SIZE
    range 64 1100 if MODBUS_SUPPORT_SERVER

config MODBUS_SUPPORT
    bool "Zephyr Modbus shared transport support"
    depends on MODBUS
    help
      Shared RTU conversion and reviewed build-local Zephyr Modbus fixes.
      Does not create workers or register application routing.

config MODBUS_SUPPORT_SERVER_HOOKS
    bool
    depends on MODBUS_SUPPORT
    help
      Internal contract selected by the synchronous RAW server adapter.
      Other interfaces retain Zephyr work submission and ordinary handling.

config MODBUS_SUPPORT_SERVER
    bool "Synchronous Zephyr RAW server adapter"
    depends on MODBUS_SUPPORT && MODBUS_SERVER && !MODBUS_FP_EXTENSIONS
    select MODBUS_RAW_ADU
    select MODBUS_SUPPORT_SERVER_HOOKS
    help
      Keep official function-code parsing and formatting, with a synchronous
      application-thread adapter and one whole-request access callback.

config MODBUS_NUMOF_RAW_ADU
    depends on MODBUS_RAW_ADU
    default 4 if MODBUS_SUPPORT_SERVER

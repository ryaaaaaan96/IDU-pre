config TRANSMIT
    bool "Table-driven slave protocol forwarding"
    depends on MODBUS && MODBUS_SERVER && !MODBUS_FP_EXTENSIONS
    select DATAPROCESS
    select VPORT
    select MODBUS_SUPPORT
    select MODBUS_SUPPORT_SERVER
    help
      Shared protocol service with fixed per-session buffers and serialized execution.
      Application threads supply byte events, receive timing and sending.

config HEAP_MEM_POOL_ADD_SIZE_TRANSMIT
    int "System heap budget for forwarding engines and sessions"
    depends on TRANSMIT
    default 8192
    range 1024 131072

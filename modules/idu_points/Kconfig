menuconfig IDU_POINTS
    bool "IDU equipment point tables"
    depends on MODBUS_CLIENT && MODBUS_SERVER
    select ZBUS
    select ZBUS_MSG_SUBSCRIBER
    select ZBUS_MSG_SUBSCRIBER_NET_BUF_POOL_ISOLATION

if IDU_POINTS

config IDU_POINT_WORDS
    int "Maximum words in one point"
    default 16
    range 2 72

config IDU_PROCESS_MAX_OUTPUTS
    int "Maximum points produced by one process transaction"
    default 24
    range 4 64

config IDU_PROCESS_QUEUE_DEPTH
    int "Asynchronous process queue depth"
    default 4
    range 1 16

config IDU_PROCESS_TIMERS
    int "Registered business timers"
    default 8
    range 1 32

config IDU_BUS_COUNT
    int "Maximum acquisition buses"
    default 2
    range 1 8

config IDU_DEVICE_COUNT
    int "Maximum acquisition devices"
    default 16
    range 1 64

config IDU_PARAMS
    bool "Transactional parameter writes and durable NVS snapshots"
    depends on FLASH && FLASH_PAGE_LAYOUT && FLASH_MAP
    select NVS
    select NVS_DATA_CRC
    select REBOOT

config IDU_PARAMS_SNAPSHOT_BYTES
    int "Maximum encoded parameter snapshot bytes"
    default 2048
    range 256 8192
    depends on IDU_PARAMS

config IDU_PARAMS_MAX_COUNT
    int "Maximum parameter points"
    default 16
    range 1 192
    depends on IDU_PARAMS

config IDU_FORWARD_STACK_SIZE
    int "Isolated Modbus forwarding workqueue stack"
    default 4096
    depends on IDU_PARAMS

config IDU_FORWARD_PORTS
    int "Independent forwarding workqueues"
    default 2
    range 1 4
    depends on IDU_PARAMS

config IDU_POINTS_QUEUE_DEPTH
    int "Maximum pending acquisition batches"
    default 6
    range 1 16

config IDU_POINTS_MAX_POINTS
    int "Maximum configured signals"
    default 64
    range 16 768

config IDU_POINTS_VALUE_WORDS
    int "Total words reserved for configured point values"
    default 512
    range 64 16384
    help
      Sum of point widths, validated at startup. Each point uses its actual
      width; a short integer does not reserve a maximum-size string buffer.

config IDU_POINTS_MAX_POLLS
    int "Maximum collection blocks"
    default 16
    range 1 512

config IDU_POINTS_STACK_SIZE
    int "Point processor stack size"
    default 4096

config IDU_COLLECT_STACK_SIZE
    int "Modbus collector stack size"
    default 4096

config IDU_COLLECT_TIMEOUT_MS
    int "Modbus acquisition response timeout (ms)"
    default 100
    range 10 1000

endif

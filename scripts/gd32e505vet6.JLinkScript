/* 通过 J-Link GDB Server 的脚本文件选项加载。
 * 设备为 GD32E505VET6，接口 SWD，采用小端。
 * 在界面中设置速度 1000 kHz、TCP 端口 2331 和远程访问。
 * 通过 GDB Server 启动参数 -rtos 加载 Zephyr RTOS 插件。
 * 继续使用设备内置的连接和复位流程。
 */

int ConfigTargetSettings(void) {
    int result;

    result = JLINK_SetDevice("GD32E505VET6");
    if (result < 0) {
        return result;
    }
    JLINK_SelectTIF(JLINK_TIF_SWD);
    JLINK_TargetEndianness = JLINK_TARGET_ENDIANNESS_I_LITTLE_D_LITTLE;
    return 0;
}
